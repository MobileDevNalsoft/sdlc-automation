worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }
    default_type application/octet-stream;

    access_log /dev/stdout;
    error_log /dev/stderr warn;
    server_tokens off;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml font/woff2;

    server {
        listen 8080;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # Healthcheck endpoint (used by Docker and loopback smoke tests)
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        # Reverse proxy to upstream backend:
        # Browser calls same-origin ${APP_BASE_PATH}api/*.
        # Upstream credentials (Basic Auth or Gateway Key) are injected securely server-side.
        # Browser NEVER receives or logs backend infrastructure secrets.
        location ^~ ${APP_BASE_PATH}api/ {
            proxy_pass ${BACKEND_UPSTREAM_ORIGIN}${BACKEND_BASE_PATH}/;
            proxy_http_version 1.1;
            proxy_set_header Authorization "Basic ${BACKEND_BASIC_AUTH_B64}";
            proxy_set_header X-SESSION-TOKEN $http_x_session_token;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header Connection "";
            proxy_ssl_server_name on;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
            proxy_ssl_verify_depth 2;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # Runtime browser config: always fetch fresh on page load
        location = ${APP_BASE_PATH}config.js {
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }

        # Service worker (if used) must never be cached aggressively
        location = ${APP_BASE_PATH}mockServiceWorker.js {
            add_header Cache-Control "no-cache" always;
            try_files $uri =404;
        }

        # Hashed static assets: cached immutably for 1 year
        location ^~ ${APP_BASE_PATH}assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        # Entry HTML: never cache so users get new deployments immediately
        location = ${APP_BASE_PATH}index.html {
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }

        # Client-side routing fallback: direct URLs return index.html
        location ${APP_BASE_PATH} {
            try_files $uri $uri/ ${APP_BASE_PATH}index.html;
        }
    }
}
