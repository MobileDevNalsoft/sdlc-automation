# -----------------------------------------------------------------------------
# Deployment Configuration Template
# Copy to .deploy.env on the operator workstation (gitignored).
# -----------------------------------------------------------------------------
DOCKER_USER=myregistryuser
IMAGE_NAME=my-web-app

# Target Deployment Host (VM / Server)
VM_USER=opc
VM_HOST=10.0.0.1
VM_KEY_PATH=C:/Users/username/.ssh/id_rsa

# Container & Network Topology
CONTAINER_NAME=my-web-app
HOST_PORT=8080
CANDIDATE_PORT=8088
APP_BASE_PATH=/

# Local Pre-flight Options
ALLOW_DIRTY_DEPLOY=false
TEST_MAX_WORKERS=2
SKIP_LOCAL_NPM_CI=false
