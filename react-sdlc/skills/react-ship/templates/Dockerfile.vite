# syntax=docker/dockerfile:1.7
#
# Production Multi-Stage Dockerfile for React 19 + Vite SPAs.
# The final runner container runs as unprivileged user 'nginx' on port 8080.
# Zero build secrets or node_modules are included in the runtime image.
# Backend gateway credentials and runtime configuration are injected at container boot.

# -----------------------------------------------------------------------------
# Stage 1: Builder
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Vite base path parameter (e.g. '/' or '/my-app/')
ARG APP_BASE_PATH=/
ENV APP_BASE_PATH=${APP_BASE_PATH}

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline

COPY . .
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Verifier (Linux-native test validation)
# -----------------------------------------------------------------------------
FROM builder AS verifier
ARG TEST_MAX_WORKERS=2
RUN npm run test -- --maxWorkers="${TEST_MAX_WORKERS}"

# -----------------------------------------------------------------------------
# Stage 3: Runner (Unprivileged Nginx)
# -----------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:alpine3.22 AS runner

ARG APP_BASE_PATH=/
ARG IMAGE_REVISION=unknown
ARG IMAGE_VERSION=unknown

LABEL org.opencontainers.image.title="Web Application" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.app.base-path="${APP_BASE_PATH}"

USER root

# Install gettext (envsubst), jq (json validator), and curl (healthcheck)
RUN apk add --no-cache ca-certificates curl gettext jq \
    && mkdir -p /etc/app /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp \
    && chown -R nginx:nginx /etc/app /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp

ENV APP_BASE_PATH=${APP_BASE_PATH}

COPY --chown=nginx:nginx docker/nginx.conf.template /etc/app/nginx.conf.template
COPY --chown=nginx:nginx docker/config.js.template /etc/app/config.js.template
COPY --chown=nginx:nginx docker/entrypoint.sh /usr/local/bin/app-entrypoint
COPY --from=builder --chown=nginx:nginx /app/dist/ /usr/share/nginx/html${APP_BASE_PATH}

RUN chmod 0555 /usr/local/bin/app-entrypoint \
    && chown -R nginx:nginx /usr/share/nginx/html

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl --fail --silent http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/app-entrypoint"]
CMD ["nginx", "-g", "daemon off;", "-c", "/tmp/app-nginx.conf"]
